<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+（API 31 起）的备份 / 换机迁移规则。理由与 backup_rules.xml 相同：
  linux/（rootfs 134MB+）与 native-extract/ 都可以再生成，纳入备份会撑爆 25MB 配额，
  系统随后按文件逐个截断 —— 该备份的 instances.json 反而可能没进去，
  恢复时还可能拿到解压到一半的 rootfs。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="linux" />
        <exclude domain="file" path="native-extract" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="linux" />
        <exclude domain="file" path="native-extract" />
    </device-transfer>
</data-extraction-rules>
