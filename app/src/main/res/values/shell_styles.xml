<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 岚壳主主题：纯代码搭界面，XML 只负责窗口级属性 -->
    <style name="Theme.KazeShell" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorAccent">#B4462A</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <!-- 底部弹层：全屏窗口 + 透明底，遮罩由自绘 View 承担 -->
    <style name="Shell_Sheet" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@style/Shell_Sheet_Anim</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="Shell_Sheet_Anim">
        <item name="android:windowEnterAnimation">@anim/shell_sheet_in</item>
        <item name="android:windowExitAnimation">@anim/shell_sheet_out</item>
    </style>

</resources>
