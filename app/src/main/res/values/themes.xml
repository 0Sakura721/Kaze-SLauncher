<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KazeSLauncher" parent="android:Theme.Material.NoActionBar" />

    <!-- 裁剪 Activity（CanHub Android-Image-Cropper）需要 AppCompat 主题（含 ActionBar 显示菜单）；
         状态栏统一白色+深色图标，并 opt-out Android 15 强制 edge-to-edge（否则图片延伸到状态栏后，
         状态栏一片图色+图标看不清，蓝白断层） -->
    <style name="Theme.KazeCrop" parent="Theme.AppCompat.Light">
        <item name="colorPrimary">@android:color/white</item>
        <item name="colorPrimaryDark">@android:color/white</item>
        <item name="colorAccent">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
