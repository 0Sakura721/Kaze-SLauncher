<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      maxSdkVersion 必须是 29（Android 10）而不是 28：
      StorageDirUtil.hasAllFilesAccess() 在 SDK < 30 时查的就是这个权限，而「所有文件访问」
      （MANAGE_EXTERNAL_STORAGE）是 API 30 才有的概念。写成 28 的话 Android 10 上这个权限
      根本不存在 —— 运行时申请被系统**直接拒绝**（连弹窗都不会出现），于是「选择自定义实例
      目录」永远失败，默认实例根 /sdcard/KazeS 也拿不到写权限。
      11+ 改走 MANAGE_EXTERNAL_STORAGE，本权限在那里没有意义，所以止于 29。（需真机在
      Android 10 上验证一次授权流程）
    -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 自定义实例目录：把游戏存到用户任意目录并直接运行（Android 11+ 分区存储下 File API 前提） -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!--
      悬浮窗（「显示在其他应用上层」）：**只**用于 AI 联网搜索的「本机浏览器」源。

      为什么要它：那条路径用一个隐藏 WebView 加载必应结果页。挂成真窗口（1px、透明、
      FLAG_NOT_TOUCHABLE + FLAG_NOT_FOCUSABLE，用户看不到也摸不到）后渲染器按前台优先级
      调度，不会被 ROM 当后台冻结；不挂窗口的"无头模式"在激进后台管理的机器上会被限流，
      页面加载不出来（搜索直接失败）。

      安全面：窗口 1px、不可触摸、不可聚焦，没有 addJavascriptInterface、不允许外跳，
      三条结束路径都 destroy WebView（见 core/ai/BrowserSearch.kt）。
      这是**可选权限**：不授予也能用（自动回退无头模式），运行时才在设置页引导。
      不声明它则 Settings.canDrawOverlays() 永远 false —— 整条真窗口分支是死代码，
      设置页那张引导卡也永远点不动。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".NewAgeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:extractNativeLibs="true"
        android:theme="@style/Theme.KazeSLauncher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|screenLayout|smallestScreenSize|fontScale|locale|layoutDirection|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 服务端守护前台服务：specialUse 类型（无 6 小时时限）+ 显式子类型属性（缺一即 SecurityException） -->
        <service
            android:name=".core.service.ServerGuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Minecraft 服务器守护：保持服务端进程在应用退到后台时不被系统回收" />
        </service>

        <!-- 更新 APK 安装：cacheDir/updates 下的文件经 FileProvider 授权给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
